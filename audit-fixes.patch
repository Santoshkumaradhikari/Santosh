+            lambda m: m.group(1) + f'\n  <p class="chapter-dates">First published {pretty(published)} · '
+                                   f'Last verified {pretty(modified)}</p>',
+            c, count=1, flags=re.S)
+
+    # 2. JSON-LD: dates, image, mainEntityOfPage
+    def enrich(m):
+        data = json.loads(m.group(1))
