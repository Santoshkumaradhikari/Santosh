-    <tr><th>Banking</th><th>CAR, NPL ratio, CD ratio</th><th>CAR near the 11 percent floor, NPL above 5 percent, or CD ratio pinned at the 90 percent ceiling</th></tr>
+    <tr><th scope="col">Banking</th><th scope="col">CAR, NPL ratio, CD ratio</th><th scope="col">CAR near the 11 percent floor, NPL above 5 percent, or CD ratio pinned at the 90 percent ceiling</th></tr>
