+def slugify(text):
+    text = re.sub(r"<[^>]+>", "", text)
+    text = html.unescape(text)
+    text = text.lower()
+    text = re.sub(r"[’'\u2019]", "", text)
+    text = re.sub(r"[^a-z0-9]+", "-", text).strip("-")
+    return text[:60].rstrip("-") or "section"
