+    <tr><th scope="col">Month</th><th scope="col">Amount Invested (NPR)</th><th scope="col">NAV per Unit (NPR)</th><th scope="col">Units Purchased</th></tr>
     <tr><td>1</td><td>5,000</td><td>10.00</td><td>500.0</td></tr>
     <tr><td>2</td><td>5,000</td><td>8.00</td><td>625.0</td></tr>
